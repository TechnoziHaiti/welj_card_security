# URL publique de votre projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://ibeclkenhejlvleztzsu.supabase.co

# Clé anonyme publique Supabase (sans danger dans le navigateur)
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique

# Clé de rôle de service Supabase (STRICTEMENT RÉSERVÉE AU SERVEUR - NE JAMAIS PRÉFIXER PAR NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role-secrete

# URL de base de l'application pour la génération des URLs de QR codes
# En local : http://localhost:3000
# En production : https://cards.welj-express.com ou https://votre-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
